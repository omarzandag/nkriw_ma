# ---------------------------------------------------------------------------
# NKRIW.MA — Docker Compose environment
# ---------------------------------------------------------------------------
# Copy this file to ".env" in the project root and edit the values for your
# environment, then run:  docker compose up -d
#
# docker-compose.yml already supplies sensible defaults (via ${VAR:-default}),
# so `docker compose up -d` works WITHOUT a .env file. A .env is only needed
# to override secrets or point at an external database / mail server.
#
# IMPORTANT: if you change POSTGRES_PASSWORD, keep DATABASE_URL in sync
# (the backend must authenticate with the same password the DB was started with).

# --- PostgreSQL (in-compose database) ---
POSTGRES_USER=nkriwma
POSTGRES_PASSWORD=nkriwma_password
POSTGRES_DB=nkriwma

# --- Backend (FastAPI) ---
# Point at another database server (e.g. a managed Postgres) by setting the
# full connection string here. Otherwise the in-compose "db" service is used.
DATABASE_URL=postgresql://nkriwma:nkriwma_password@db:5432/nkriwma

# JWT signing secret — CHANGE THIS for production.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-a-long-random-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Admin bootstrap account (created automatically on first startup)
ADMIN_EMAIL=admin@nkriw.ma
ADMIN_PASSWORD=admin123

MAX_FILE_SIZE_MB=5

# CORS origins (JSON array). In Docker the SPA and API are same-origin (both
# served by nginx on :80), so CORS is not triggered in production. The default
# in docker-compose.yml also lists the Vite dev port (5173) for local frontend.
BACKEND_CORS_ORIGINS=["http://localhost:80","http://localhost:5173","https://nkriw.ma"]

# --- Frontend (nginx reverse proxy) ---
# Where nginx forwards /api and /uploads requests. In Docker Compose the
# backend service is reachable at "http://backend:8000".
BACKEND_URL=http://backend:8000
# Host port exposed by the frontend nginx service
FRONTEND_PORT=80

# --- App ---
APP_NAME=NKRIW.MA
APP_VERSION=1.0.0
DEBUG=False

# --- SMTP (bootstrap defaults; also configurable from Admin Dashboard) ---
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# NOTE: smtp_password is NOT read from env — it is set by the admin from the
# Admin Dashboard > Email Settings (stored in the DB site_settings table).
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NKRIW.MA
SMTP_USE_TLS=True
SMTP_USE_SSL=False
