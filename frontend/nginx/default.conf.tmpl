# nginx reverse-proxy config for NKRIW.MA.
# Generated at container start from this template via envsubst (see
# 00-substitute.sh). Only ${BACKEND_URL} is substituted; nginx's own
# variables ($host, $uri, ...) are left intact.
#
# The SPA is served directly; /api and /uploads are proxied verbatim to the
# FastAPI backend. No path rewriting: a request like /api/auth/login reaches
# the backend as http://backend:8000/api/auth/login (routers are prefixed /api).

server {
    listen 80;
    listen [::]:80;
    server_name _;
    charset utf-8;

    # Uploaded files can be large (photos on housing/colocation ads)
    client_max_body_size 20m;

    root /usr/share/nginx/html;
    index index.html;

    # Backend API (FastAPI routers all live under /api)
    location /api {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect      off;
    }

    # Backend-served uploads (StaticFiles mounted at /uploads)
    location /uploads {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect      off;
    }

    # Frontend SPA: serve files, fall back to index.html for client routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
